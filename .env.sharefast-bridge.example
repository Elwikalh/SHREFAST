# PREPARATION ONLY. Disabled by default. Server-only values, never NEXT_PUBLIC.
SHAREFAST_EL7BBOB_ENABLED="false"
SHAREFAST_EL7BBOB_SECRET=""
SHAREFAST_EL7BBOB_MERCHANT_REF=""
SHAREFAST_EL7BBOB_COMPANY_REF=""

# Quote enforcement is on by default. Explicit false only for a reviewed legacy-outbox drain.
SHAREFAST_EL7BBOB_REQUIRE_QUOTES="true"
# Server-owned pickup-zone enrollment; MAIN defaults to the bound merchant's zone.
SHAREFAST_EL7BBOB_BRANCH_ZONES_JSON=""
# Optional reviewed mappings from active restaurant zone names to registered pricing zones.
SHAREFAST_EL7BBOB_DEST_ZONES_JSON=""

# Separate opt-in, not activated by the bridge. Root ref above must match this exact active merchant account.
SHAREFAST_EL7BBOB_POLICY_ENABLED="false"
SHAREFAST_EL7BBOB_ACCOUNT_ID=""
# This policy exempts app subscription only; it never waives delivery/courier costs or changes accepted jobs.

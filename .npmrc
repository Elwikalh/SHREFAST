# Next.js standalone output (used by our Docker build) resolves some of
# next's internal transitive deps (like @swc/helpers) via plain Node.js
# module resolution. pnpm's default isolated ".pnpm" virtual-store layout
# breaks that resolution inside the container. Hoisting node_modules avoids it.
node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
